  m_Script: {fileID: 11500000, guid: c7e1999334fba864fad9af985eb40730, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FamilyMember
  memberIndex: 2
  memberName: Mao
  rescueLines:
  - "\xA1Onix! Resististe todo... estoy orgulloso de ti."
  - Pero ten cuidado... Kiwi sigue rondando.
  postRescueSpeaker: Kiwi
  postRescueLines:
  - "\xA1Grrr! \xBFC\xF3mo cruzaste todas mis trampas, chucho?"
  - "\xA1Esta familia no obedece nada! \xA1Me largo! \xA1Bah!"
  epilogueSpeaker: Emily
  epilogueLines:
  - "Justo entonces aparece Emily, la mam\xE1 de Kiwi."
  - "Emily: \"\xA1Kiwi! Lo vi TODO desde casa, jovencita.\""
  - "\"Mira que asustar a esta linda familia... \xA1qu\xE9 malcriada!\""
  - "\"Est\xE1s castigada: \xA1a tu habitaci\xF3n ahora mismo!\""
  - "Kiwi se va cabizbaja a su cuarto. \xA1Onix por fin reuni\xF3 a su familia, felices
    para siempre!"
  happySprite: {fileID: 0}
